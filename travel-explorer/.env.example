# Copy this file to .env.local and fill in your own key. Never commit .env.local.
# Leave empty to run in demo mode with sample data.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud Console (Map Management). Needed for custom pin styling.
VITE_GOOGLE_MAP_ID=

# Optional: separate key for YouTube Data API v3 (defaults to VITE_GOOGLE_MAPS_API_KEY).
VITE_YOUTUBE_API_KEY=
# Optional: where the blog-article server lives (default: /api/articles on the same site).
VITE_ARTICLES_ENDPOINT=

# Server-side only (no VITE_ prefix, never sent to the browser): Brave Search key for blog articles.
BRAVE_API_KEY=
