{
  "name": "travel-explorer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
  // Secrets (never commit): npx wrangler secret put BRAVE_API_KEY
  // Optional: "vars": { "ALLOWED_ORIGINS": "https://your-domain" }
}
