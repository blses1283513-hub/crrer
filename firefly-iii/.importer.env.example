# Data Importer 設定 —— 複製為 .importer.env 後修改。
# 完整清單：https://github.com/firefly-iii/data-importer/blob/main/.env.example

# 容器之間互連用的內部網址（不用改）
FIREFLY_III_URL=http://app:8080
# 瀏覽器看得到的 Firefly III 網址（與 .env 的 APP_URL 相同）
VANITY_URL=http://192.168.1.100:8080

# 在 Firefly III「選項 → 個人資料 → OAuth → 個人存取權杖」建立後貼上
FIREFLY_III_ACCESS_TOKEN=

TZ=Asia/Taipei
FALLBACK_LOCALE=zh_TW
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=notice
TRUSTED_PROXIES=**
