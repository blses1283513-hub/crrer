# Firefly III 主程式設定 —— 複製為 .env 後修改。
# 只列出家用需要調整的項目；其餘使用官方預設值。
# 完整清單：https://github.com/firefly-iii/firefly-iii/blob/main/.env.example

APP_ENV=production
APP_DEBUG=false
SITE_OWNER=you@example.com

# 剛好 32 個字元的隨機字串。產生方式：
#   head -c 200 /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32
# ⚠️ 設定後不可再改，否則已加密資料無法讀取。
APP_KEY=REPLACE_WITH_32_RANDOM_CHARACTERS

# 介面語言：繁體中文；時區：台北
DEFAULT_LANGUAGE=zh_TW
DEFAULT_LOCALE=equal
TZ=Asia/Taipei

# 瀏覽器實際開啟的網址（NAS IP + 埠號）
APP_URL=http://192.168.1.100:8080
TRUSTED_PROXIES=**

LOG_CHANNEL=stack
APP_LOG_LEVEL=notice
AUDIT_LOG_LEVEL=emergency

# 資料庫：必須與 .db.env 的 MYSQL_* 一致
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# 排程權杖：剛好 32 個字元（產生方式同 APP_KEY，但要用不同的值）
STATIC_CRON_TOKEN=REPLACE_WITH_ANOTHER_32_CHARS_XX

# 地圖預設位置：台北
MAP_DEFAULT_LAT=25.0330
MAP_DEFAULT_LONG=121.5654
MAP_DEFAULT_ZOOM=10
